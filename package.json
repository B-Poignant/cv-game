{
  "name": "cv-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run cv:html && npm run build:server",
    "preview": "vite preview",
    "format": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest --project unit",
    "server": "tsx server/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier . --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node build/server/index.js",
    "cv:html": "tsx scripts/buildCvPage.ts"
  },
  "devDependencies": {
    "@colyseus/testing": "^0.18.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.6",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "jiti": "^2.7.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.36",
    "@colyseus/sdk": "^0.18.5",
    "colyseus": "^0.18.9",
    "express": "^5.3.0",
    "pixi.js": "^8.22.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
